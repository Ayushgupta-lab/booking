# Server Port
PORT=3000

# MongoDB Connection String (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostelhub?retryWrites=true&w=majority

# Email OTP via Gmail (Enable 2FA and generate an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or Custom SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediCare Hospital <no-reply@medicare.local>

# SMS OTP (configure any one provider for live SMS delivery)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWOFACTOR_API_KEY=
